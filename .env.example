# --- Credentials (fill these in) ---

# MINIMUM to go live: set ONE LLM provider key and you have a working streaming
# chatbot. Add the other keys to unlock email / calendar features.

# Pick your LLM provider — the first one with a key set wins:
#   1. ANTHROPIC_API_KEY  -> Claude         2. OPENAI_API_KEY -> OpenAI
#   3. LLM_API_KEY        -> LiteLLM proxy  4. ZAI_API_KEY    -> Z.ai GLM (default legacy)

# --- 1. Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- 2. OpenAI ---
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o

# --- 3. LiteLLM proxy (or any OpenAI-compatible endpoint) ---
# LLM_API_KEY=your_litellm_key
# LLM_BASE_URL=https://your-litellm-proxy.example/v1
# LLM_MODEL=your-model-name

# --- 4. Z.ai GLM Coding Plan (default) ---
# Coding endpoint: https://api.z.ai/api/coding/paas/v4
ZAI_API_KEY=your_zai_key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3-flash

# Resend (email) - sign up at https://resend.com, key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Internal inbox that all assistant messages are delivered to
ASSISTANT_INTERNAL_EMAIL=you@example.com

# Public ntfy.sh topic used for push notifications (no auth). Optional.
NTFY_TOPIC=your_topic

# Calendly - Personal Access Token
# Create at: https://calendly.com/integrations/api_webhooks
CALENDLY_ACCESS_TOKEN=your_calendly_pat

# Vercel deployment token (used with: vercel --token)
VERCEL_TOKEN=vcp_xxx

# --- Optional ---

# Branding: overrides the page title / meta description (defaults: Frontdesk AI)
ASSISTANT_NAME=Frontdesk AI
ASSISTANT_TAGLINE=Personal AI assistant - schedules meetings, sends messages, and answers questions.

# Email "from" address (must be verified in Resend for production)
ASSISTANT_EMAIL_FROM=Concierge <you@example.com>

# Timezone used when presenting availability (IANA name)
ASSISTANT_TIMEZONE=America/New_York

# --- Frontend branding (NEXT_PUBLIC_* are inlined into the client bundle) ---
# Title shown in the header / used in the copied agent set-up guide
NEXT_PUBLIC_ASSISTANT_NAME=Frontdesk AI
# Headline under the name in the header card
NEXT_PUBLIC_ASSISTANT_TAGLINE=Personal AI assistant
# Public contact email shown as a mailto link
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
# Public profile links (empty = link hidden)
NEXT_PUBLIC_LINKEDIN=https://linkedin.com/in/you
NEXT_PUBLIC_GITHUB=https://github.com/you
# UPI id shown as a "Buy me a coffee" button (empty = button hidden)
NEXT_PUBLIC_UPI_ID=you@upi
# Your live site URL (used as the fallback origin in the copied agent config)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Multi-protocol feature flags (all default to enabled) ---
# MCP (POST /api/mcp) and A2A (POST /a2a, /.well-known/agent-card.json)
# both require a provider API key via the Authorization: Bearer header.
# Set to false to disable either surface.
# MCP_ENABLED=true
# A2A_ENABLED=true

# Vercel project id for deploy script status reporting. If unset, the deploy
# scripts read .vercel/project.json (created by `vercel link`).
# VERCEL_PROJECT_ID=prj_xxx